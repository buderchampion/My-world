{
    "_about": "Ability scores, after the AD&D 1st edition Player's Handbook (Data.NPCS.abilities). peoples: adjust is added to the roll; limits are [lowest, highest] after adjusting, and strength_pct is the highest exceptional Strength (18/01-18/00, 100 meaning 18/00) a fighter of that people can reach. Peoples not in the book (Dragonborn, Tiefling, Orc) are adapted in the same spirit. classes: minimums (and, for the Barbarian of Unearthed Arcana, maximums) a person must meet to follow the class, and the prime requisites: 16 or more in every one gives +10% experience. Bard, Sorcerer and Warlock are adapted (the book's Bard is far too rare for everyday bards). exceptional: the classes that roll exceptional Strength at 18.",
    "peoples": {
        "Human":      {"adjust": {}, "limits": {}, "strength_pct": 100},
        "Dwarf":      {"adjust": {"constitution": 1, "charisma": -1},
                       "limits": {"strength": [8, 18], "dexterity": [3, 17], "constitution": [12, 19], "charisma": [3, 16]},
                       "strength_pct": 99},
        "Elf":        {"adjust": {"dexterity": 1, "constitution": -1},
                       "limits": {"intelligence": [8, 18], "dexterity": [7, 19], "constitution": [6, 18], "charisma": [8, 18]},
                       "strength_pct": 75},
        "Gnome":      {"adjust": {},
                       "limits": {"strength": [6, 18], "intelligence": [7, 18], "constitution": [8, 18]},
                       "strength_pct": 50},
        "Half-Elf":   {"adjust": {},
                       "limits": {"intelligence": [4, 18], "dexterity": [6, 18], "constitution": [6, 18]},
                       "strength_pct": 90},
        "Halfling":   {"adjust": {"strength": -1, "dexterity": 1},
                       "limits": {"strength": [6, 17], "intelligence": [6, 18], "wisdom": [3, 17], "dexterity": [8, 18],
                                  "constitution": [10, 19]},
                       "strength_pct": 0},
        "Half-Orc":   {"adjust": {"strength": 1, "constitution": 1, "charisma": -2},
                       "limits": {"strength": [6, 18], "intelligence": [3, 17], "wisdom": [3, 14], "dexterity": [3, 17],
                                  "constitution": [13, 19], "charisma": [3, 12]},
                       "strength_pct": 99},
        "Dragonborn": {"adjust": {"strength": 1, "charisma": 1},
                       "limits": {"strength": [8, 18], "dexterity": [3, 17], "constitution": [6, 18], "charisma": [6, 18]},
                       "strength_pct": 99},
        "Tiefling":   {"adjust": {"intelligence": 1, "charisma": -1},
                       "limits": {"intelligence": [6, 18], "dexterity": [6, 18], "charisma": [3, 16]},
                       "strength_pct": 75},
        "Orc":        {"adjust": {"strength": 2, "constitution": 1, "intelligence": -1, "charisma": -2},
                       "limits": {"strength": [8, 18], "intelligence": [3, 16], "wisdom": [3, 14], "dexterity": [3, 17],
                                  "constitution": [12, 19], "charisma": [3, 12]},
                       "strength_pct": 100}
    },
    "classes": {
        "Fighter":   {"minimums": {"strength": 9, "constitution": 7, "wisdom": 6, "dexterity": 6, "charisma": 6}, "prime": ["strength"]},
        "Paladin":   {"minimums": {"strength": 12, "intelligence": 9, "wisdom": 13, "constitution": 9, "charisma": 17},
                      "prime": ["strength", "wisdom"]},
        "Ranger":    {"minimums": {"strength": 13, "intelligence": 13, "wisdom": 14, "constitution": 14},
                      "prime": ["strength", "intelligence", "wisdom"]},
        "Cleric":    {"minimums": {"wisdom": 9}, "prime": ["wisdom"]},
        "Druid":     {"minimums": {"wisdom": 12, "charisma": 15}, "prime": ["wisdom", "charisma"]},
        "Wizard":    {"minimums": {"intelligence": 9, "dexterity": 6}, "prime": ["intelligence"]},
        "Rogue":     {"minimums": {"dexterity": 9}, "prime": ["dexterity"]},
        "Monk":      {"minimums": {"strength": 15, "wisdom": 15, "dexterity": 15, "constitution": 11}, "prime": []},
        "Barbarian": {"minimums": {"strength": 15, "dexterity": 14, "constitution": 15}, "maximums": {"wisdom": 16}, "prime": []},
        "Bard":      {"minimums": {"dexterity": 12, "intelligence": 10, "charisma": 15}, "prime": ["dexterity", "charisma"]},
        "Sorcerer":  {"minimums": {"intelligence": 9, "constitution": 9, "charisma": 13}, "prime": ["charisma"]},
        "Warlock":   {"minimums": {"intelligence": 9, "charisma": 13}, "prime": ["charisma"]}
    },
    "exceptional": ["Fighter", "Paladin", "Ranger", "Barbarian"]
